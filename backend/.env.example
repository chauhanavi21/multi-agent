# Copy to backend/.env and fill in values. Never commit .env to git.

DATABASE_URL=postgresql://agent:agentpass@localhost:5432/salesagent
REDIS_URL=redis://localhost:6379/0

OLLAMA_BASE_URL=http://localhost:11434
JWT_SECRET=change-me-to-a-long-random-string

# Optional — cloud AI (Tier 2+)
ANTHROPIC_API_KEY=

# Optional — Twilio SMS
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=

# Optional — Apify Instagram scraping
APIFY_TOKEN=

# Scheduler: in_process | disabled
SCHEDULER_MODE=in_process

# Stripe (optional — see docs/STRIPE_SETUP.md)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_ID_PRO=
STRIPE_PRICE_ID_TEAM=
FRONTEND_BASE_URL=http://localhost:5173
